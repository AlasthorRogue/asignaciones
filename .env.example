# Flask configuration
SECRET_KEY=your-secret-key-here-change-in-production
FLASK_ENV=production

# Allowed CORS origins (comma-separated, no trailing slash)
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# Database configuration
DB_SERVER=your-db-server
DB_NAME=HGT_Assignments
DB_TRUSTED_CONNECTION=yes
# DB_USER=sa
# DB_PASSWORD=your-password

# Session configuration (timeout in seconds = 30 min)
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=1800
SESSION_TYPE=null
SESSION_PERMANENT=True

# Para sesiones persistentes en producción (escalable multi-proceso):
# SESSION_TYPE=redis
# SESSION_REDIS=redis://localhost:6379/0

# Alternativa filesystem (no recomendada, solo desarrollo local):
# SESSION_TYPE=filesystem
# SESSION_FILE_DIR=C:\ProgramData\HGT\sessions
# SESSION_FILE_THRESHOLD=500
